<?xml version="1.0" encoding="utf-8"?>
<!--
  Licence page. A real tab page, not a floating layer.

  The previous revision declared this as a `float="true"` layout inside
  configpage.xml and toggled it with a `visible` write. That cannot work: the only
  way to get a control write onto the screen is a hide/show round trip, and that
  round trip rebuilds the page from its XML, which restores `visible="false"`. The
  write was therefore erased by the very commit that was supposed to display it,
  and clicking the licence link looked like a dead control.

  As a tab page it needs no visibility state at all: showing it is a page switch.

  Height is 536 like the configuration page so the window does not jump, but the
  hero is dropped here - the brand plate would leave only 188px for the text. The
  page keeps the same 32px margin and the same title/subtitle sizes as the rest.
-->
<Windows>
  <VerticalLayout bkcolor="#FFFFFFFF">
    <Control height="28" />

    <VerticalLayout height="22" padding="32,0,32,0">
      <Label font="2" textcolor="#FF0F0F11" text="许可协议" />
    </VerticalLayout>
    <Control height="8" />
    <VerticalLayout height="18" padding="32,0,32,0">
      <Label font="3" textcolor="#FF8A8A90" text="YarkText 以 MIT 许可证发布，可自由使用、修改与再分发。" />
    </VerticalLayout>

    <Control height="20" />

    <VerticalLayout padding="32,0,32,0" height="320">
      <RichEdit name="editLicense" height="320" font="3" textcolor="#FF3A3A42" bkcolor="#FFF6F6F8" bordersize="1" bordercolor="#FFE4E4E8" borderround="8,8" readonly="true" multiline="true" autovscroll="true" vscrollbar="true" inset="16,14,12,14" />
    </VerticalLayout>

    <Control />

    <VerticalLayout height="60" padding="32,0,32,0">
      <HorizontalLayout height="36">
        <Control />
        <Button name="btnAgree" width="120" height="36" font="1" text="返回" textcolor="#FFFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#FFFFFFFF" bkcolor="#FF0F0F11" hotbkcolor="#FF26262E" pushedbkcolor="#FF000000" borderround="8,8" />
      </HorizontalLayout>
      <Control height="24" />
    </VerticalLayout>
  </VerticalLayout>
</Windows>
