[Desktop Entry]
Name=YarkDown
Comment=Next generation markdown editor
Exec=yarkdown %F
Terminal=false
Type=Application
Icon=yarkdown
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=yarkdown;
StartupWMClass=yarkdown
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=yarkdown --new-window %F
Icon=yarkdown
