[Desktop Entry]
Name=YarkText
Comment=Next generation markdown editor
Exec=yarktext %F
Terminal=false
Type=Application
Icon=yarktext
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=yarktext;
StartupWMClass=yarktext
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=yarktext --new-window %F
Icon=yarktext
